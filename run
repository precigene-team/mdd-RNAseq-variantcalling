#!/bin/bash
# [[run]]
# Goal: Master script to orchestrate the RNA-seq pipeline modules.

# Exit on error
set -e

# --- Project Root Discovery ---
export PROJECT_ROOT="$(dirname "$(realpath "$0")")"
# ------------------------------

# --- Logging Setup ---
LOG_DIR="$PROJECT_ROOT/_data/logs/run"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/run_$(date +%Y%m%d_%H%M%S).log"
exec > >(tee -a "$LOG_FILE") 2>&1
echo "Log file: $LOG_FILE"
# ---------------------

echo "========================================================="
echo "   MDD RNA-seq Pipeline - Pipeline Runner"
echo "   Starting at: $(date)"
echo "========================================================="

# --- Resource Detection ---
export THREADS=${SLURM_CPUS_PER_TASK:-$(nproc 2>/dev/null || echo 16)}
if [ -n "$SLURM_MEM_PER_NODE" ]; then
    export MEM_GB=$(($SLURM_MEM_PER_NODE / 1024))
else
    export MEM_GB=$(free -g 2>/dev/null | awk '/^Mem:/{print $2}' || echo 128)
fi
echo "   Resources: $THREADS threads, $MEM_GB GB RAM detected."
echo "---------------------------------------------------------"

# 1. Environment Check
if [[ "$CONDA_DEFAULT_ENV" != "mdd" ]]; then
    echo "WARNING: The 'mdd' environment is not active."
    echo ""
    read -p "Do you want to proceed using system tools? [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo "Aborting. Please activate the environment."
        exit 1
    fi
fi

# 2. Argument Logic
RUN_CORE=false
RUN_DGE=false
RUN_VC=false

if [ "$#" -eq 0 ]; then
    echo "Usage: ./run {core|dge|vc|all}"
    exit 1
fi

for arg in "$@"; do
    case $arg in
        core) RUN_CORE=true ;;
        dge)  RUN_DGE=true ;;
        vc)   RUN_VC=true ;;
        all)  RUN_CORE=true; RUN_DGE=true; RUN_VC=true ;;
        script)
            if [ "$#" -lt 2 ]; then
                echo "Usage: ./run script <path_to_script> [args...]"
                exit 1
            fi
            SCRIPT_PATH="$2"
            shift 2
            echo ">>> Running Individual Script: $SCRIPT_PATH"
            # Extract directory and filename
            SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
            SCRIPT_FILE=$(basename "$SCRIPT_PATH")
            (
                cd "$SCRIPT_DIR"
                if [[ "$SCRIPT_FILE" == *.sh ]]; then
                    bash "$SCRIPT_FILE" "$@"
                elif [[ "$SCRIPT_FILE" == *.R ]]; then
                    Rscript "$SCRIPT_FILE" "$@"
                else
                    echo "Unknown script type: $SCRIPT_FILE"
                    exit 1
                fi
            )
            exit 0
            ;;
        *)    echo "Unknown argument: $arg. Use 'core', 'dge', 'vc', 'all', or 'script'."; exit 1 ;;
    esac
done

# 3. CORE ALIGNMENT
if [ "$RUN_CORE" = true ]; then
    echo ">>> Running CORE ALIGNMENT Module..."
    (
        cd 01_core_alignment/
        # bash 01_raw_fastqc.sh
        # bash 02_trimming.sh
        # bash 03_rrna_filter.sh
        # bash 04_trimmed_fastqc.sh
        # bash 05_star_align.sh
        # bash 06_qualimap_bamqc.sh
        # bash 07_qualimap_rnaseq.sh
        bash 08_quantification.sh
        bash 09_counts_qc.sh
        bash 10_multiqc.sh
    ) || { echo "Core Alignment failed. Exiting."; exit 1; }
    echo "CORE ALIGNMENT COMPLETE."
    echo ""
fi

# 4. DGE ANALYSIS
if [ "$RUN_DGE" = true ]; then
    echo ">>> Running DGE ANALYSIS Module..."
    (
        cd 02_dge_analysis/
        Rscript 01_gene_mapping.R
        Rscript 02_rna_processing.R
        Rscript 03_pca_analysis.R
        Rscript 04_deg_analysis.R
        Rscript 05_dge_plotting.R
    ) || { echo "DGE Analysis failed. Exiting."; exit 1; }
    echo "DGE ANALYSIS COMPLETE."
    echo ""
fi

# 5. VARIANT CALLING
if [ "$RUN_VC" = true ]; then
    echo ">>> Running VARIANT CALLING Module..."
    (
        cd 03_variant_calling/
        if [ -f "01_read_groups.sh" ]; then
            bash 01_read_groups.sh
            bash 02_mark_duplicates.sh
            bash 03_split_n_cigar.sh
            bash 04_haplotype_caller.sh
            bash 05_variant_filtration.sh
        else
            echo "Variant calling scripts (GATK Best Practices) are not yet implemented. Please complete the tasks in TODO.md first."
            exit 1
        fi
    ) || { echo "Variant Calling failed. Exiting."; exit 1; }
    echo "VARIANT CALLING COMPLETE."
    echo ""
fi

echo "========================================================="
echo "   All requested modules completed successfully."
echo "   Completed at: $(date)"
echo "========================================================="
