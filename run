#!/bin/bash
# [[run]]
# Goal: Master script to orchestrate the RNA-seq pipeline modules.

# Exit on error
set -e

# --- Project Root Discovery ---
if [ -n "${SLURM_SUBMIT_DIR:-}" ]; then
    export PROJECT_ROOT="$SLURM_SUBMIT_DIR"
else
    curr_dir="$(pwd)"
    while [ "$curr_dir" != "/" ] && [ -n "$curr_dir" ]; do
        if [ -f "$curr_dir/run" ]; then
            export PROJECT_ROOT="$curr_dir"
            break
        fi
        curr_dir="$(dirname "$curr_dir")"
    done
fi
export PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
# ------------------------------

# --- Pipeline Resource Configuration ---
# 1. Slurm Job Array Submission Config
export VC_ARRAY_CONCURRENCY=5    # Max concurrent array tasks running in parallel
export VC_TASK_CPUS=1            # CPUs per task in Slurm Job Array
export VC_TASK_MEM="32G"         # Memory per task in Slurm Job Array (must fit all tools)
export VC_TASK_TIME="48:00:00"   # Max walltime per task in Slurm Job Array

# 2. Local/Single-Batch Mode Config (e.g. hpc_run.sbatch)
export VC_LOCAL_CONCURRENT=2     # Max concurrent samples running locally
export VC_LOCAL_CPUS=1           # CPUs per sample running locally

# 3. Step Definitions (script_name | step_label | memory_limit | cpu_limit)
VC_STEPS=(
    "01_read_groups.sh|Read Groups|8G|1"
    "02_mark_duplicates.sh|Mark Duplicates|12G|1"
    "03_split_n_cigar.sh|Split N Cigar|12G|4"
    "04_haplotype_caller.sh|Haplotype Caller|24G|4"
)

# 4. Post-Calling Steps (Steps 08-22, README order; 17 is the shared plot helper
#    sourced by 18-22, so it is never invoked directly)
VC_POST_STEPS=(
    "python3|08_build_transcriptome_snp_table.py"
    "python3|09_functional_annotation.py"
    "python3|10_prioritize_mdd_candidate_snps.py"
    "python3|11_build_burden_matrix.py"
    "python3|12_fetch_opentargets_panel.py"
    "Rscript|13_export_pathway_sets.R"
    "python3|14_gene_burden_test.py"
    "Rscript|15_plot_burden_results.R"
    "Rscript|16_burden_control_vs_mdd_table.R"
    "Rscript|18_plot_burden_reactome.R"
    "Rscript|19_plot_burden_kegg.R"
    "Rscript|20_plot_burden_go_bp.R"
    "Rscript|21_plot_burden_go_cc.R"
    "Rscript|22_plot_burden_go_mf.R"
)

run_vc_post() {
    local tag="${1:-Local}"
    for step in "${VC_POST_STEPS[@]}"; do
        interp="${step%%|*}"
        script="${step##*|}"
        step_num="${script:0:2}"
        echo ">>> [$tag] Running Step $step_num: $script..."
        "$interp" "$PROJECT_ROOT/03_variant_calling/$script" || { echo "ERROR: Step $step_num ($script) failed." >&2; exit 1; }
    done
    echo ">>> [$tag] Steps 08-22 (Annotation + Burden) complete."
}
# --------------------------------------

# --- Logging Setup ---
LOG_DIR="$PROJECT_ROOT/_data/logs/run"
mkdir -p "$LOG_DIR"
if [ -z "${SLURM_ARRAY_TASK_ID:-}" ]; then
    LOG_FILE="$LOG_DIR/run_$(date +%Y%m%d_%H%M%S).log"
    exec > >(tee -a "$LOG_FILE") 2>&1
    echo "Log file: $LOG_FILE"
fi
# ---------------------

echo "========================================================="
echo "   MDD RNA-seq Pipeline - Pipeline Runner"
echo "   Starting at: $(date)"
echo "========================================================="

# --- Resource Detection ---
export THREADS=${SLURM_CPUS_PER_TASK:-$(nproc 2>/dev/null || echo 16)}
if [ -n "$SLURM_MEM_PER_NODE" ]; then
    export MEM_GB=$(($SLURM_MEM_PER_NODE / 1024))
else
    export MEM_GB=$(free -g 2>/dev/null | awk '/^Mem:/{print $2}' || echo 128)
fi
echo "   Resources: $THREADS threads, $MEM_GB GB RAM detected."
echo "---------------------------------------------------------"

# 1. Environment Check
if [[ "$CONDA_DEFAULT_ENV" != "mdd" ]]; then
    # Auto-activate mdd environment in batch/Slurm execution mode or attempt hook activation
    eval "$(micromamba shell hook --shell bash 2>/dev/null || mamba shell hook --shell bash 2>/dev/null || conda shell.bash hook 2>/dev/null)"
    micromamba activate mdd 2>/dev/null || mamba activate mdd 2>/dev/null || conda activate mdd 2>/dev/null || true
fi

if [[ "$CONDA_DEFAULT_ENV" != "mdd" ]]; then
    if [ -n "${SLURM_JOB_ID:-}" ]; then
        echo "WARNING: Running in Slurm job but 'mdd' environment could not be auto-activated."
    else
        echo "WARNING: The 'mdd' environment is not active."
        echo ""
        read -p "Do you want to proceed using system tools? [y/N]: " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "Aborting. Please activate the environment."
            exit 1
        fi
    fi
fi

# 2. Argument Logic
RUN_CORE=false
RUN_DGE=false
RUN_VC=false
RUN_VC_POST=false

if [ "$#" -eq 0 ]; then
    echo "Usage: ./run {core|dge|vc|vc-post|all}"
    exit 1
fi

while [ "$#" -gt 0 ]; do
    arg="$1"
    case $arg in
        core) RUN_CORE=true; shift ;;
        dge)  RUN_DGE=true; shift ;;
        vc)
            # If we are already running inside a Slurm batch job (but not an array task),
            # run local multi-processing mode inside the existing allocation.
            if [ -n "${SLURM_JOB_ID:-}" ] && [ -z "${SLURM_ARRAY_TASK_ID:-}" ]; then
                RUN_VC=true
                shift
            else
                # We count aligned coordinate-sorted BAM files in total
                BAM_COUNT=$(find "$PROJECT_ROOT/_data/bam" -name "*_Aligned.sortedByCoord.out.bam" | grep -v '^$' | wc -l || echo 0)
                if [ "$BAM_COUNT" -eq 0 ]; then
                    echo "ERROR: No aligned BAM files found in _data/bam/." >&2
                    exit 1
                fi
                MAX_INDEX=$((BAM_COUNT - 1))
                echo "[INFO] Submitting Slurm Job Arrays (Step-by-Step Chained) for $BAM_COUNT samples..."
                
                PREV_JOB_ID=""
                for i in "${!VC_STEPS[@]}"; do
                    step_num=$((i + 1))
                    step_info="${VC_STEPS[$i]}"
                    
                    # Parse script name, step label, and CPUs
                    script=$(echo "$step_info" | cut -d'|' -f1)
                    name=$(echo "$step_info" | cut -d'|' -f2)
                    
                    # Skip already completed precursor steps (Steps 1-3)
                    if [ "$step_num" -lt 4 ]; then
                        echo "  [Skip] Step $step_num ($name) submission (already completed)"
                        continue
                    fi
                    
                    step_cpus=$(echo "$step_info" | cut -d'|' -f4)
                    step_cpus="${step_cpus:-$VC_TASK_CPUS}"
                    
                    # Format step label to lower snake_case for dynamic folder structures
                    step_dir=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr ' ' '_')
                    mkdir -p "$PROJECT_ROOT/_data/logs/run/vc_array/${step_dir}"
                    
                    # Construct dependency argument if there is a previous job in the chain
                    dep_arg=""
                    if [ -n "$PREV_JOB_ID" ]; then
                        dep_arg="--dependency=afterok:$PREV_JOB_ID"
                    fi
                    
                    # Submit the job array for the current step
                    PREV_JOB_ID=$(sbatch --parsable --job-name="vc_step${step_num}" \
                                   $dep_arg \
                                   --array="0-${MAX_INDEX}%${VC_ARRAY_CONCURRENCY}" \
                                   --cpus-per-task="${step_cpus}" \
                                   --mem="${VC_TASK_MEM}" \
                                   --time="${VC_TASK_TIME}" \
                                   --output="_data/logs/run/vc_array/${step_dir}/task_%A_%a.log" \
                                   --error="_data/logs/run/vc_array/${step_dir}/task_%A_%a.err" \
                                   "$PROJECT_ROOT/run" vc-task "$step_num")
                    
                    if [ -z "$dep_arg" ]; then
                        echo "  -> Submitted Step $step_num ($name) - Job ID: $PREV_JOB_ID"
                    else
                        echo "  -> Submitted Step $step_num ($name) - Job ID: $PREV_JOB_ID (Dependent on $dep_arg)"
                    fi
                done

                # --- Steps 05-07: GVCF combine, genotype, filter (single jobs) ---
                mkdir -p "$PROJECT_ROOT/_data/logs/combine_gvcfs" \
                         "$PROJECT_ROOT/_data/logs/genotype_gvcfs" \
                         "$PROJECT_ROOT/_data/logs/variant_filtration" \
                         "$PROJECT_ROOT/_data/logs/vc_annotation_burden"
                
                echo ""
                echo "[INFO] Submitting Step 5 (CombineGVCFs)..."
                COMBINE_JOB_ID=$(sbatch --parsable \
                    --dependency=afterok:$PREV_JOB_ID \
                    --job-name="vc_combine_gvcfs" \
                    "$PROJECT_ROOT/03_variant_calling/05_combine_gvcfs.sh")
                echo "  -> Submitted Step 5 (CombineGVCFs) - Job ID: $COMBINE_JOB_ID"
                
                echo "[INFO] Submitting Step 6 (GenotypeGVCFs)..."
                GENOTYPE_JOB_ID=$(sbatch --parsable \
                    --dependency=afterok:$COMBINE_JOB_ID \
                    --job-name="vc_genotype_gvcfs" \
                    "$PROJECT_ROOT/03_variant_calling/06_genotype_gvcfs.sh")
                echo "  -> Submitted Step 6 (GenotypeGVCFs) - Job ID: $GENOTYPE_JOB_ID"
                
                echo "[INFO] Submitting Step 7 (VariantFiltration + split)..."
                FILTER_JOB_ID=$(sbatch --parsable \
                    --dependency=afterok:$GENOTYPE_JOB_ID \
                    --job-name="vc_variant_filtration" \
                    "$PROJECT_ROOT/03_variant_calling/07_variant_filtration.sh")
                echo "  -> Submitted Step 7 (VariantFiltration + split) - Job ID: $FILTER_JOB_ID"

                # --- Steps 08-22: transcriptome SNP table, annotation, burden test (single job) ---
                echo "[INFO] Submitting Steps 8-22 (Annotation + Burden)..."
                POST_JOB_ID=$(sbatch --parsable \
                    --dependency=afterok:$FILTER_JOB_ID \
                    --job-name="vc_annotation_burden" \
                    --cpus-per-task="${VC_TASK_CPUS}" \
                    --mem="${VC_TASK_MEM}" \
                    --time="${VC_TASK_TIME}" \
                    --output="_data/logs/vc_annotation_burden/annot_burden_%j.log" \
                    --error="_data/logs/vc_annotation_burden/annot_burden_%j.err" \
                    "$PROJECT_ROOT/run" vc-post)
                if [ -z "$POST_JOB_ID" ]; then
                    echo "  [WARN] Steps 8-22 submission failed. Run them manually: ./run vc-post" >&2
                else
                    echo "  -> Submitted Steps 8-22 (Annotation + Burden) - Job ID: $POST_JOB_ID (Dependent on $FILTER_JOB_ID)"
                fi
                echo ""
                echo "========================================================="
                echo "   All VC steps submitted. Pipeline is running."
                echo "   Monitor with: squeue -u \$USER"
                echo "========================================================="
                exit 0
            fi
            ;;
        vc-post)
            RUN_VC_POST=true
            shift
        ;;
        vc-task)
            # Executed by Slurm inside each array task
            if [ -z "$SLURM_ARRAY_TASK_ID" ]; then
                echo "ERROR: vc-task must be run inside a Slurm Job Array (SLURM_ARRAY_TASK_ID is not set)." >&2
                exit 1
            fi
            RUN_VC=true
            export VC_TASK_STEP="${2:-}"
            shift 2
            ;;
        all)  RUN_CORE=true; RUN_DGE=true; RUN_VC=true; shift ;;
        script)
            if [ "$#" -lt 2 ]; then
                echo "Usage: ./run script <path_to_script> [args...]"
                exit 1
            fi
            SCRIPT_PATH="$2"
            shift 2
            echo ">>> Running Individual Script: $SCRIPT_PATH"
            # Extract directory and filename
            SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
            SCRIPT_FILE=$(basename "$SCRIPT_PATH")
            (
                cd "$SCRIPT_DIR"
                if [[ "$SCRIPT_FILE" == *.sh ]]; then
                    bash "$SCRIPT_FILE" "$@"
                elif [[ "$SCRIPT_FILE" == *.R ]]; then
                    Rscript "$SCRIPT_FILE" "$@"
                else
                    echo "Unknown script type: $SCRIPT_FILE"
                    exit 1
                fi
            )
            exit 0
            ;;
        *)
            echo "Unknown argument: $arg. Use 'core', 'dge', 'vc', 'all', or 'script'."
            exit 1
            ;;
    esac
done

# 3. CORE ALIGNMENT
if [ "$RUN_CORE" = true ]; then
    echo ">>> Running CORE ALIGNMENT Module..."
    (
        cd 01_core_alignment/
        bash 01_raw_fastqc.sh || { echo "ERROR: Step 01 (01_raw_fastqc.sh) failed." >&2; exit 1; }
        bash 02_trimming.sh || { echo "ERROR: Step 02 (02_trimming.sh) failed." >&2; exit 1; }
        bash 03_rrna_filter.sh || { echo "ERROR: Step 03 (03_rrna_filter.sh) failed." >&2; exit 1; }
        bash 04_trimmed_fastqc.sh || { echo "ERROR: Step 04 (04_trimmed_fastqc.sh) failed." >&2; exit 1; }
        bash 05_star_align.sh || { echo "ERROR: Step 05 (05_star_align.sh) failed." >&2; exit 1; }
        bash 06_qualimap_bamqc.sh || { echo "ERROR: Step 06 (06_qualimap_bamqc.sh) failed." >&2; exit 1; }
        bash 07_qualimap_rnaseq.sh || { echo "ERROR: Step 07 (07_qualimap_rnaseq.sh) failed." >&2; exit 1; }
        bash 08_quantification.sh || { echo "ERROR: Step 08 (08_quantification.sh) failed." >&2; exit 1; }
        bash 09_counts_qc.sh || { echo "ERROR: Step 09 (09_counts_qc.sh) failed." >&2; exit 1; }
        bash 10_multiqc.sh || { echo "ERROR: Step 10 (10_multiqc.sh) failed." >&2; exit 1; }
    ) || { echo "Core Alignment failed. Exiting."; exit 1; }
    echo "CORE ALIGNMENT COMPLETE."
    echo ""
fi

# 4. DGE ANALYSIS
if [ "$RUN_DGE" = true ]; then
    echo ">>> Running DGE ANALYSIS Module..."
    (
        cd 02_dge_analysis/
        Rscript 01_gene_mapping.R || { echo "ERROR: Step 01 (01_gene_mapping.R) failed." >&2; exit 1; }
        Rscript 02_rna_processing.R || { echo "ERROR: Step 02 (02_rna_processing.R) failed." >&2; exit 1; }
        Rscript 03_pca_analysis.R || { echo "ERROR: Step 03 (03_pca_analysis.R) failed." >&2; exit 1; }
        Rscript 04_deg_analysis.R || { echo "ERROR: Step 04 (04_deg_analysis.R) failed." >&2; exit 1; }
        Rscript 05_dge_plotting.R || { echo "ERROR: Step 05 (05_dge_plotting.R) failed." >&2; exit 1; }
        Rscript 06_annotate_results.R || { echo "ERROR: Step 06 (06_annotate_results.R) failed." >&2; exit 1; }
        Rscript 07_enrichment_analysis.R || { echo "ERROR: Step 07 (07_enrichment_analysis.R) failed." >&2; exit 1; }
        Rscript 08_enrichment_plotting.R || { echo "ERROR: Step 08 (08_enrichment_plotting.R) failed." >&2; exit 1; }
        Rscript 09_heatmap_pathway.R || { echo "ERROR: Step 09 (09_heatmap_pathway.R) failed." >&2; exit 1; }
    ) || { echo "DGE Analysis failed. Exiting."; exit 1; }
    echo "DGE ANALYSIS COMPLETE."
    echo ""
fi

# 5. VARIANT CALLING
if [ "$RUN_VC" = true ]; then
    echo ">>> Running VARIANT CALLING Module..."
    (
        cd 03_variant_calling/
        
        # Build the static cohort list based on raw BAM files
        BAM_DIR="$PROJECT_ROOT/_data/bam"
        RAW_BAM_LIST=$(find "$BAM_DIR" -name "*_Aligned.sortedByCoord.out.bam" | sort)
        BAM_COUNT=$(echo "$RAW_BAM_LIST" | grep -v '^$' | wc -l || echo 0)
        
        if [ "$BAM_COUNT" -eq 0 ]; then
            echo "ERROR: No aligned BAM files found in $BAM_DIR." >&2
            exit 1
        fi

        # Create all required pipeline folders once to prevent redundant mkdir syscalls
        mkdir -p "$PROJECT_ROOT/_data/variant/readgroups" \
                 "$PROJECT_ROOT/_data/variant/duplicates" \
                 "$PROJECT_ROOT/_data/variant/split_n_cigar" \
                 "$PROJECT_ROOT/_data/variant/raw_vcf" \
                 "$PROJECT_ROOT/_data/variant/snps_raw" \
                 "$PROJECT_ROOT/_data/variant/filtered_vcf" \
                 "$PROJECT_ROOT/_data/logs/readgroups" \
                 "$PROJECT_ROOT/_data/logs/duplicates" \
                 "$PROJECT_ROOT/_data/logs/split_n_cigar" \
                 "$PROJECT_ROOT/_data/logs/haplotype_caller" \
                 "$PROJECT_ROOT/_data/logs/variant_filtration" \
                 "$PROJECT_ROOT/_data/tmp"
        
        # 5.1 Run task in Slurm Array mode
        if [ -n "${SLURM_ARRAY_TASK_ID:-}" ]; then
            RAW_BAM=$(echo "$RAW_BAM_LIST" | sed -n "$((SLURM_ARRAY_TASK_ID + 1))p")
            SAMPLE_NAME=$(basename "$RAW_BAM" _Aligned.sortedByCoord.out.bam)
            
            if [ -z "$VC_TASK_STEP" ]; then
                echo "ERROR: VC_TASK_STEP is not defined in Slurm Array task mode." >&2
                exit 1
            fi
            
            # Resolve script and memory from VC_STEPS dynamically
            step_idx=$((VC_TASK_STEP - 1))
            step_info="${VC_STEPS[$step_idx]}"
            
            if [ -z "$step_info" ]; then
                echo "ERROR: Unknown task step index $step_idx." >&2
                exit 1
            fi
            
            script=$(echo "$step_info" | cut -d'|' -f1)
            name=$(echo "$step_info" | cut -d'|' -f2)
            mem_val=$(echo "$step_info" | cut -d'|' -f3)
            step_cpus=$(echo "$step_info" | cut -d'|' -f4)
            step_cpus="${step_cpus:-$VC_TASK_CPUS}"
            
            echo ">>> [Slurm Task $SLURM_ARRAY_TASK_ID] Running Step $VC_TASK_STEP ($name): $script for Sample: $SAMPLE_NAME"
            bash "$script" "$SAMPLE_NAME" "${SLURM_CPUS_PER_TASK:-$step_cpus}" "$mem_val"
            echo ">>> [Slurm Task $SLURM_ARRAY_TASK_ID] Finished Step $VC_TASK_STEP ($name) for Sample: $SAMPLE_NAME"
            
        # 5.2 Run task in Local Multi-processing mode
        else
            echo ">>> Running Variant Calling locally for $BAM_COUNT samples..."
            
            CONCURRENT_SAMPLES=$VC_LOCAL_CONCURRENT
            CPUS_PER_SAMPLE=$VC_LOCAL_CPUS
            
            echo "Local resource plan: $CONCURRENT_SAMPLES concurrent samples, each with $CPUS_PER_SAMPLE CPU and GATK recommended memory."
            
            # Helper function to run a specific step cohort-wide in local mode
            run_local_step() {
                local step_script="$1"
                local step_mem="$2"
                local step_name="$3"
                echo ">>> [Local] Starting Cohort-wide Step: $step_name"
                for raw_bam in $RAW_BAM_LIST; do
                    [ -f "$raw_bam" ] || continue
                    sample=$(basename "$raw_bam" _Aligned.sortedByCoord.out.bam)
                    
                    while [ $(jobs -r | wc -l) -ge "$CONCURRENT_SAMPLES" ]; do
                        sleep 5
                    done
                    
                    bash "$step_script" "$sample" "$CPUS_PER_SAMPLE" "$step_mem" &
                done
                wait
                echo ">>> [Local] Finished Cohort-wide Step: $step_name"
            }

            # Loop through centralized VC_STEPS to run cohort-wide locally
            for i in "${!VC_STEPS[@]}"; do
                step_num=$((i + 1))
                step_info="${VC_STEPS[$i]}"
                script=$(echo "$step_info" | cut -d'|' -f1)
                name=$(echo "$step_info" | cut -d'|' -f2)
                mem_val=$(echo "$step_info" | cut -d'|' -f3)
                
                # Skip already completed precursor steps (Steps 1-3)
                if [ "$step_num" -lt 4 ]; then
                    echo ">>> [Local Skip] Step $step_num ($name) (already completed)"
                    continue
                fi
                
                run_local_step "$script" "$mem_val" "$name"
            done

            # Post-array steps: CombineGVCFs → GenotypeGVCFs → VariantFiltration + split
            echo ">>> [Local] Running Step 5: CombineGVCFs..."
            bash "$PROJECT_ROOT/03_variant_calling/05_combine_gvcfs.sh" || exit 1
            
            echo ">>> [Local] Running Step 6: GenotypeGVCFs..."
            bash "$PROJECT_ROOT/03_variant_calling/06_genotype_gvcfs.sh" || exit 1
            
            echo ">>> [Local] Running Step 7: VariantFiltration + split..."
            bash "$PROJECT_ROOT/03_variant_calling/07_variant_filtration.sh" || exit 1

            # Post-calling steps: transcriptome SNP table, annotation, burden test (08-22)
            run_vc_post "Local"
        fi
    ) || { echo "Variant Calling failed. Exiting."; exit 1; }
    echo "VARIANT CALLING COMPLETE."
    echo ""
fi

# --- Annotation & Burden Module (Steps 08-22, standalone) ---
if [ "$RUN_VC_POST" = true ]; then
    echo ">>> Running ANNOTATION & BURDEN Module (Steps 08-22)..."
    (
        run_vc_post "Local"
    ) || { echo "Annotation & Burden failed. Exiting."; exit 1; }
    echo "ANNOTATION & BURDEN COMPLETE."
    echo ""
fi

echo "========================================================="
echo "   All requested modules completed successfully."
echo "   Completed at: $(date)"
echo "========================================================="
